# Copie para .env e preencha. O .env nunca vai para o GitHub.
# No Streamlit Cloud, as mesmas variaveis ficam em Settings -> Secrets.

# Banco Postgres (Neon)
DATABASE_URL=postgresql://usuario:senha@servidor/banco?sslmode=require

# Amazon Athena (anuncios do Agente 1)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
# ATHENA_DATABASE=imoveis
# ATHENA_TABLE=anuncios
# ATHENA_WORKGROUP=

# Coleta reserva (Apify)
APIFY_TOKEN_2=

# IAs (planos gratuitos)
GROQ_API_KEY=
GROQ_API_KEY_2=
GOOGLE_API_KEY=
GOOGLE_API_KEY_2=
NVIDIA_API_KEY=
ZAI_API_KEY=

# Qwen no Google Colab (desligado; para religar, preencha e descomente)
# QWEN_API_URL=
# QWEN_API_KEY=

# Mapas e entorno
GOOGLE_MAPS_KEY=
TOMTOM_API_KEY=
GEOAPIFY_API_KEY=

# Modelos de IA (opcional; sem a linha vale o padrao de services/ia.py)
GROQ_MODELO_TEXTO_GRANDE=openai/gpt-oss-120b
GROQ_MODELO_TEXTO_PEQUENO=openai/gpt-oss-20b
GROQ_MODELO_VISAO=qwen/qwen3.8-27b
GEMINI_MODELO=gemini-3.5-flash-lite
NVIDIA_MODELO_TEXTO=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_MODELO_VISAO=nvidia/nemotron-3.5-super-vl-120b-a12b
ZAI_MODELO_TEXTO=glm-4.7-flash
ZAI_MODELO_VISAO=glm-4.6v-flash

# Ordem das IAs por tarefa (opcional; sem a linha vale o padrao abaixo).
# Nomes: groq (as duas chaves), groq1, groq2, gemini, nvidia, zai, qwen.
ORDEM_COMPARAVEIS=groq,gemini,nvidia,zai
ORDEM_ZONA=gemini,groq1,nvidia
ORDEM_FOTOS_ALVO=gemini,groq1,nvidia
ORDEM_FOTOS_COMPARAVEIS=groq1,nvidia,gemini
ORDEM_REGIAO=gemini,groq1,nvidia,zai

# Fotos por chamada no Agente 3 (opcional)
FOTOS_GEMINI=4
FOTOS_GROQ=2
FOTOS_NVIDIA=1
FOTOS_ZAI=1
FOTOS_QWEN=4
